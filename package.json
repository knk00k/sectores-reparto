{
  "name": "sectores-reparto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Herramienta visual para extraer y ajustar sectores de reparto desde KMZ y KML.",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "node --test",
    "firebase:deploy": "npm run build && firebase deploy --only hosting"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.18.3",
    "jszip": "3.10.1",
    "leaflet": "1.9.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "vite": "^7.1.0"
  }
}
